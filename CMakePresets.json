{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64",
      "displayName": "MSVC x64",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/x64"
    },
    {
      "name": "x86",
      "displayName": "MSVC x86",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/x86"
    },
    {
      "name": "macos",
      "displayName": "macOS arm64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS arm64 Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "android",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android armeabi-v7a",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/android-armv7",
      "cacheVariables": {
        "ANDROID_ABI": "armeabi-v7a"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/android-x86_64",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "android-x86",
      "displayName": "Android x86",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/android-x86",
      "cacheVariables": {
        "ANDROID_ABI": "x86"
      }
    },
    {
      "name": "android-riscv64",
      "displayName": "Android riscv64",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/android-riscv64",
      "cacheVariables": {
        "ANDROID_ABI": "riscv64",
        "ANDROID_PLATFORM": "android-36"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release"
    },
    {
      "name": "x64-release-dlls",
      "displayName": "Release DLLs (x64)",
      "configurePreset": "x64",
      "configuration": "Release",
      "targets": ["Aqsh"]
    },
    {
      "name": "x64-release-demo",
      "displayName": "Release DLLs + demo (x64)",
      "configurePreset": "x64",
      "configuration": "Release",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "x86-debug",
      "configurePreset": "x86",
      "configuration": "Debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "x86",
      "configuration": "Release"
    },
    {
      "name": "x86-release-dlls",
      "displayName": "Release DLLs (x86)",
      "configurePreset": "x86",
      "configuration": "Release",
      "targets": ["Aqsh"]
    },
    {
      "name": "x86-release-demo",
      "displayName": "Release DLLs + demo (x86)",
      "configurePreset": "x86",
      "configuration": "Release",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "demo",
      "displayName": "Yukkuri demo (x64 Debug)",
      "configurePreset": "x64",
      "configuration": "Debug",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "macos-release",
      "displayName": "Release dylib + demo (macOS)",
      "configurePreset": "macos",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "macos-debug-demo",
      "displayName": "Debug dylib + demo (macOS)",
      "configurePreset": "macos-debug",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "linux-release",
      "displayName": "Release library + demo (Linux)",
      "configurePreset": "linux",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "linux-debug-demo",
      "displayName": "Debug library + demo (Linux)",
      "configurePreset": "linux-debug",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "android-arm64-release",
      "displayName": "Release library + demo (Android arm64)",
      "configurePreset": "android-arm64",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "android-armv7-release",
      "displayName": "Release library + demo (Android armv7)",
      "configurePreset": "android-armv7",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "android-x86_64-release",
      "displayName": "Release library + demo (Android x86_64)",
      "configurePreset": "android-x86_64",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "android-x86-release",
      "displayName": "Release library + demo (Android x86)",
      "configurePreset": "android-x86",
      "targets": ["aqtk_demo"]
    },
    {
      "name": "android-riscv64-release",
      "displayName": "Release library + demo (Android riscv64)",
      "configurePreset": "android-riscv64",
      "targets": ["aqtk_demo"]
    }
  ]
}
